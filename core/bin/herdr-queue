#!/usr/bin/env python3
"""무거운 검사(테스트·e2e)의 공용 대기열. 이 기계의 모든 프로젝트가 함께 쓴다.

  herdr-queue                                  대기열을 보여 준다
  herdr-queue urgent <역할> [--project P]      그 역할의 검사를 대기열 맨 앞으로. 대기 중인 검사가 없으면 다음 검사 한 번에 건다
  herdr-queue normal <역할> [--project P]      급함 표시를 푼다
  herdr-queue cancel [--sha S]                 이 세션($HERDR_PROJECT/$HERDR_ROLE)이 넣은 대기·실행 중인 검사만 멈춘다(pkill 대신)
  herdr-queue ahead                            지금 실행·대기 중인 검사 수
  herdr-queue drop <역할> [--sha S] [--project P]  그 역할의 대기 중인 줄을 뺀다(SHA 를 주면 그 SHA 로 시작하는 줄만).
                                               실행 중인 줄은 건드리지 않는다(--running 이면 그 줄의 대기열 프로세스에만 신호해 끈다).
                                               빠진·꺼진 줄을 기다리던 프로세스는 끝 코드 75 로 끝난다(실패 아님)
  herdr-queue run --role R --sha S [--timeout 초] [--log 파일] [--wait-file 파일] [--supersede] -- <명령…>
                                               자리를 얻으면 명령을 돌리고 끝나면 자리를 내놓는다(herdr-check가 쓴다)
                                               --supersede: 같은 프로젝트·역할의 앞선 줄 가운데 이 SHA 가 품는(조상인) 커밋의 줄을
                                               거둔다(대기 줄은 빼고, 실행 중인 줄은 그 프로세스에만 신호). 거둔 쪽은 끝 코드 76.
                                               병합 뒤 기본 브랜치 전체 검사(역할 merged)가 쓴다

자리: HERDR_HEAVY_SLOTS(기본 1)개가 동시에 돈다. 순서는 급함, 들어온 순이다.
시작 가드: 자리를 얻은 뒤 가용 메모리가 HERDR_HEAVY_MIN_MEM_GB 이상, 1분 부하가 HERDR_HEAVY_MAX_LOAD 미만이 될 때까지
기다린다(0이면 보지 않는다. HERDR_HEAVY_MAX_LOAD=auto는 코어 수×0.75). 기다리는 동안 자리를 쥐고 있으므로 뒤 검사도 함께 기다린다.
메모리 상한: 명령은 자기 systemd scope에서 HERDR_HEAVY_MEM_MAX(기본 50%) 상한으로 돈다(herdr-scope). 넘으면 이 검사만 끝난다.
시간 제한은 명령의 실행 시간에만 건다. 대기열과 가드에서 기다린 시간은 세지 않고, 기다리는 동안 순번을 알린다.
명령은 새 프로세스 묶음으로 돌리고, 시간 초과나 중단 때 묶음째 끝낸다(고아 검사가 남지 않는다).
기록 위치: HERDR_HEAVY_DIR(기본 ~/.claude/herdr/heavy). 프로세스가 죽은 표는 다음 사람이 치운다.

설정 값(HERDR_HEAVY_SLOTS·HERDR_HEAVY_MIN_MEM_GB·HERDR_HEAVY_MAX_LOAD)은 기다리는 동안에도 돌 때마다 다시 읽는다.
우선순위(앞이 이긴다):
  1. HERDR_HEAVY_FORCE_SLOTS·HERDR_HEAVY_FORCE_MIN_MEM_GB·HERDR_HEAVY_FORCE_MAX_LOAD 환경 변수 — 시험·급할 때 강제로 덮어쓴다
  2. 설정 파일의 값 — 기본은 이 스크립트 옆의 ../harness.env, HERDR_HEAVY_ENV_FILE 로 바꿀 수 있다.
     셸 문법(KEY=VALUE, 주석, 따옴표, export)으로 읽기만 하고 실행하지 않는다. 빈 값은 없는 것으로 본다
  3. 같은 이름의 환경 변수(herdr-check 가 넘긴 값 등)
  4. 기본값: 자리 1, 가드 끔. 숫자가 아닌 값도 기본값으로 본다
가용 메모리는 리눅스에선 /proc/meminfo 의 MemAvailable, macOS 에선 vm_stat 의 free+inactive+speculative 쪽수×쪽 크기다.
값을 못 읽으면 메모리 가드는 막지 않는다.
"""
import argparse
import fcntl
import json
import os
import re
import shlex
import signal
import subprocess
import sys
import time
import uuid

BASE = os.environ.get("HERDR_HEAVY_DIR") or os.path.join(os.path.expanduser("~"), ".claude", "herdr", "heavy")
TICKETS = os.path.join(BASE, "tickets")
URGENT = os.path.join(BASE, "urgent")
POLL = float(os.environ.get("HERDR_HEAVY_POLL", "2"))
NOTICE_EVERY = 300  # 순번이 그대로여도 이 간격(초)마다 다시 알린다
DROPPED, SUPERSEDED = 75, 76  # drop 으로 빠진 줄, 뒤 커밋이 품어 거둔 줄의 끝 코드(실패가 아니다)
GONE = {"drop": DROPPED, "superseded": SUPERSEDED}


ENV_FILE = os.environ.get("HERDR_HEAVY_ENV_FILE") or os.path.join(
    os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "harness.env")
SETTINGS = ("HERDR_HEAVY_SLOTS", "HERDR_HEAVY_MIN_MEM_GB", "HERDR_HEAVY_MAX_LOAD")


def read_env_file(path):
    """셸 문법 설정 파일에서 SETTINGS 이름만 읽는다(실행하지 않는다). 같은 이름이 여러 번이면 셸처럼 뒤가 이긴다."""
    out = {}
    try:
        with open(path) as f:
            lines = f.read().splitlines()
    except (OSError, UnicodeDecodeError):
        return out
    for line in lines:
        s = line.strip()
        if s.startswith("export "):
            s = s[len("export "):].lstrip()
        key, sep, value = s.partition("=")
        if not sep or key not in SETTINGS:
            continue
        try:
            words = shlex.split(value, comments=True)
        except ValueError:
            continue
        out[key] = words[0] if words else ""
    return out


def setting(name):
    """우선순위: HERDR_HEAVY_FORCE_* > 설정 파일 > 환경 변수 > 빈 값(머리 주석)."""
    forced = os.environ.get(name.replace("HERDR_HEAVY_", "HERDR_HEAVY_FORCE_", 1))
    if forced:
        return forced.strip()
    return (read_env_file(ENV_FILE).get(name) or os.environ.get(name) or "").strip()


def env_num(name, default):
    try:
        return float(setting(name) or default)
    except ValueError:
        return float(default)


def slots_now():
    return max(int(env_num("HERDR_HEAVY_SLOTS", 1)), 1)


def available_gb():
    """가용 메모리(GB). 읽지 못하면 None."""
    try:
        with open("/proc/meminfo") as f:
            kb = next(int(line.split()[1]) for line in f if line.startswith("MemAvailable:"))
        return kb / 1048576
    except (OSError, StopIteration, ValueError, IndexError):
        pass
    try:
        out = subprocess.run(["vm_stat"], capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return None
    size = re.search(r"page size of (\d+) bytes", out)
    pages = dict((k, int(v)) for k, v in re.findall(r"^Pages (free|inactive|speculative):\s+(\d+)\.", out, re.M))
    if not size or len(pages) < 3:
        return None
    return sum(pages.values()) * int(size.group(1)) / 1024 ** 3


class Mutex:
    def __enter__(self):
        os.makedirs(TICKETS, exist_ok=True)
        os.makedirs(URGENT, exist_ok=True)
        self.f = open(os.path.join(BASE, ".mutex"), "a")
        fcntl.flock(self.f, fcntl.LOCK_EX)
        return self

    def __exit__(self, *exc):
        fcntl.flock(self.f, fcntl.LOCK_UN)
        self.f.close()


def alive(pid):
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def write(ticket):
    path = os.path.join(TICKETS, ticket["id"] + ".json")
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(ticket, f)
    os.replace(tmp, path)


def load():
    """살아 있는 표만 돌려준다. 죽은 프로세스의 표는 지운다(뮤텍스 안에서 부른다)."""
    out = []
    for name in os.listdir(TICKETS):
        if not name.endswith(".json"):
            continue
        path = os.path.join(TICKETS, name)
        try:
            with open(path) as f:
                t = json.load(f)
        except (OSError, ValueError):
            continue
        if alive(int(t.get("pid", 0))):
            out.append(t)
        else:
            try:
                os.remove(path)
            except OSError:
                pass
    return out


def ordered(tickets):
    running = sorted((t for t in tickets if t["state"] == "run"), key=lambda t: t.get("started", 0))
    waiting = sorted((t for t in tickets if t["state"] == "wait"), key=lambda t: (t["prio"], t["created"]))
    return running, waiting


def ago(epoch):
    s = int(time.time() - epoch)
    h, rest = divmod(s, 3600)
    m, s = divmod(rest, 60)
    return f"{h}h{m:02d}m" if h else (f"{m}m{s:02d}s" if m else f"{s}s")


def who(t):
    return f"{t['project']}/{t['role']}"


def max_load_limit():
    raw = setting("HERDR_HEAVY_MAX_LOAD") or "0"
    if raw == "auto":
        return (os.cpu_count() or 4) * 0.75
    return env_num("HERDR_HEAVY_MAX_LOAD", 0)


def guard_reason():
    min_gb, max_load = env_num("HERDR_HEAVY_MIN_MEM_GB", 0), max_load_limit()
    if min_gb > 0:
        gb = available_gb()
        if gb is not None and gb < min_gb:
            return f"가용 메모리 {gb:.1f}GB < {min_gb:g}GB"
    if max_load > 0:
        try:
            load1 = os.getloadavg()[0]
            if load1 >= max_load:
                return f"1분 부하 {load1:.1f} ≥ {max_load:g}"
        except OSError:
            pass
    return None


def say(msg):
    print(f"[대기열] {msg}", file=sys.stderr, flush=True)


def cmd_run(a):
    if not a.command:
        sys.exit("돌릴 명령이 없다: herdr-queue run … -- <명령>")
    project = a.project or os.environ.get("HERDR_PROJECT") or os.path.basename(os.getcwd())
    me = {"id": f"{time.time_ns()}-{uuid.uuid4().hex[:6]}", "project": project, "role": a.role, "sha": a.sha,
          "pid": os.getpid(), "prio": 5, "created": time.time(), "state": "wait"}
    child = None

    def cleanup():
        try:
            os.remove(os.path.join(TICKETS, me["id"] + ".json"))
        except OSError:
            pass

    def own_state():
        try:
            with open(os.path.join(TICKETS, me["id"] + ".json")) as f:
                return json.load(f).get("state")
        except (OSError, ValueError):
            return None

    def stop(signum, _frame):
        gone = GONE.get(own_state())  # --supersede 가 거두며 보낸 신호면 실패가 아닌 끝 코드로 끝난다
        if child is not None and child.poll() is None:
            try:
                os.killpg(child.pid, signal.SIGTERM)
            except OSError:
                pass
        cleanup()
        if gone:
            say("뒤 커밋의 검사가 이 검사를 거뒀다(그 커밋이 이 커밋을 품는다)" if gone == 76 else "이 줄을 실행 중에 뺐다(herdr-queue drop --running, 실패 아님)")
        sys.exit(gone or 128 + signum)

    for s in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(s, stop)

    with Mutex():
        flag = os.path.join(URGENT, f"{project}__{a.role}")
        if os.path.exists(flag):
            me["prio"] = 0
            os.remove(flag)
        write(me)
        if a.supersede and a.sha:
            supersede(project, a.role, a.sha, me["id"])
    entered, last_note, last_said = time.time(), None, 0
    try:
        while True:
            with Mutex():
                tickets = load()
                own = next((t for t in tickets if t["id"] == me["id"]), None)
                if own and own["state"] in GONE:
                    say("뒤 커밋의 검사가 이 검사를 거뒀다" if own["state"] == "superseded" else "대기열에서 이 줄을 뺐다(herdr-queue drop)")
                    return GONE[own["state"]]
                running, waiting = ordered(tickets)
                mine = next((t for t in waiting if t["id"] == me["id"]), None)
                me["prio"] = mine["prio"] if mine else me["prio"]
                pos = waiting.index(mine) if mine else 0
                slots = slots_now()  # 기다리는 동안 설정이 바뀌면 다음 차례부터 새 자리 수를 따른다
                if len(running) < slots and pos < slots - len(running):
                    reason = guard_reason()
                    me["state"], me["started"] = "run", time.time()
                    write(me)
                    break
            ahead = ", ".join(f"{who(t)} 실행 {ago(t['started'])}" for t in running)
            note = f"{pos + 1}번째로 기다린다" + (" (급함)" if me["prio"] == 0 else "") + (f" · 앞: {ahead}" if ahead else "")
            if note != last_note or time.time() - last_said >= NOTICE_EVERY:
                say(f"{note} · 대기 {ago(entered)}")
                last_note, last_said = note, time.time()
            time.sleep(POLL)
        while reason:
            if reason != last_note or time.time() - last_said >= NOTICE_EVERY:
                say(f"자리를 얻었지만 {reason}라 시작을 미룬다 · 대기 {ago(entered)}")
                last_note, last_said = reason, time.time()
            time.sleep(POLL)
            reason = guard_reason()
        waited = int(time.time() - entered)
        if a.wait_file:
            with open(a.wait_file, "w") as f:
                f.write(f"{waited}\n")
        if waited >= 1:
            say(f"자리를 얻었다(기다린 시간 {ago(entered)})")
        out = open(a.log, "a") if a.log else None
        scope = os.path.join(os.path.dirname(os.path.abspath(__file__)), "herdr-scope")
        command = a.command
        if os.access(scope, os.X_OK):
            # 자기 cgroup에서 메모리 상한을 두고 돈다. herdr-scope는 exec로 바뀌므로 PID·프로세스 묶음이 그대로다
            command = [scope, f"{project}-{a.role}-heavy", os.environ.get("HERDR_HEAVY_MEM_MAX", "50%"), "--"] + a.command
        child = subprocess.Popen(command, start_new_session=True, stdout=out, stderr=subprocess.STDOUT if out else None)
        try:
            return child.wait(timeout=a.timeout if a.timeout and a.timeout > 0 else None)
        except subprocess.TimeoutExpired:
            say(f"실행 시간이 {a.timeout}초를 넘어 끊는다(대기 시간은 세지 않았다)")
            try:
                os.killpg(child.pid, signal.SIGTERM)
                child.wait(timeout=10)
            except (OSError, subprocess.TimeoutExpired):
                try:
                    os.killpg(child.pid, signal.SIGKILL)
                except OSError:
                    pass
                child.wait()
            return 124
    finally:
        cleanup()


def is_ancestor(old, new):
    """old 커밋이 new 커밋의 조상(같은 커밋 포함)인가. 지금 폴더의 저장소로 본다. 모르면 거짓."""
    try:
        return subprocess.run(["git", "merge-base", "--is-ancestor", old.split("+")[0], new.split("+")[0]],
                              capture_output=True, timeout=30).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def supersede(project, role, sha, my_id):
    """같은 프로젝트·역할의 앞선 줄 가운데 sha 가 품는 커밋의 줄을 거둔다(뮤텍스 안에서 부른다)."""
    for t in load():
        if t["id"] == my_id or t["project"] != project or t["role"] != role or t["state"] not in ("wait", "run"):
            continue
        if not t.get("sha") or t["sha"] == sha or not is_ancestor(t["sha"], sha):
            say(f"거두지 않음: {who(t)} {t.get('sha', '')[:12]}({'같은 커밋' if t.get('sha') == sha else '이 커밋이 품지 않음'})")
            continue
        was, t["state"] = t["state"], "superseded"
        write(t)
        if was == "run":
            try:
                os.kill(int(t["pid"]), signal.SIGTERM)  # 그 검사의 대기열 프로세스만. 그 프로세스가 자기 명령 묶음을 끝낸다
            except OSError:
                pass
        say(f"거둠: {who(t)} {t['sha'][:12]}({'실행 중' if was == 'run' else '대기 중'}) — {sha[:12]} 가 품는다")


def cmd_drop(a):
    project = a.project or os.environ.get("HERDR_PROJECT") or os.path.basename(os.getcwd())
    with Mutex():
        running, waiting = ordered(load())
        pick = lambda t: t["project"] == project and t["role"] == a.role and (not a.sha or t["sha"].startswith(a.sha))
        hit = [t for t in waiting if pick(t)]
        stop = [t for t in running if pick(t)] if a.running else []
        for t in hit + stop:
            t["state"] = "drop"
            write(t)
    for t in hit:
        print(f"뺌: {who(t)} {t['sha'][:12]}(대기 중)")
    for t in stop:  # --running: 그 줄의 대기열 프로세스에만 신호. 그 프로세스가 자기 명령 묶음을 끝내고 끝 코드 75 로 끝난다
        try:
            os.kill(int(t["pid"]), signal.SIGTERM)
        except (ProcessLookupError, ValueError, KeyError):
            pass
        print(f"뺌: {who(t)} {t['sha'][:12]}(실행 중 — 끔)")
    hit = hit + stop
    for t in (t for t in running if pick(t) and not a.running):
        print(f"그대로 둠: {who(t)} {t['sha'][:12]}(실행 중 — drop 은 대기 줄만 뺀다. 실행 중도 빼려면 --running)")
    if not hit:
        print(f"뺄 대기 줄이 없다: {project}/{a.role}" + (f" {a.sha}" if a.sha else ""))


def cmd_mark(a, prio):
    project = a.project or os.environ.get("HERDR_PROJECT") or os.path.basename(os.getcwd())
    with Mutex():
        running, waiting = ordered(load())
        hit = [t for t in waiting if t["project"] == project and t["role"] == a.role]
        for t in hit:
            t["prio"] = prio
            write(t)
        flag = os.path.join(URGENT, f"{project}__{a.role}")
        if prio == 0 and not hit:
            open(flag, "w").close()
        if prio != 0 and os.path.exists(flag):
            os.remove(flag)
    target = f"{project}/{a.role}"
    if prio == 0:
        print(f"급함: {target} 대기 중인 검사 {len(hit)}건을 맨 앞으로 옮겼다" if hit
              else f"급함: {target}의 다음 검사 한 번을 맨 앞에 세운다(지금 대기 중인 검사 없음)")
    else:
        print(f"보통: {target} 급함 표시를 풀었다")


def cmd_cancel(a):
    """부른 세션의 프로젝트·역할 표만 멈춘다. 대상은 환경에서만 정하므로 다른 역할·프로젝트는 고를 수 없다."""
    project, role = os.environ.get("HERDR_PROJECT"), os.environ.get("HERDR_ROLE")
    if not project or not role:
        sys.exit("HERDR_PROJECT·HERDR_ROLE이 없는 세션은 취소할 대상을 정할 수 없다")
    if not os.path.isdir(TICKETS):
        print("취소할 검사가 없다")
        return
    with Mutex():
        mine = [t for t in load() if t["project"] == project and t["role"] == role
                and (not a.sha or t["sha"].startswith(a.sha))]
    hit = 0
    for t in mine:
        pid = int(t["pid"])
        try:
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                argv = f.read().split(b"\0")
            ours = any(x.endswith(b"herdr-queue") for x in argv) and b"run" in argv and \
                b"--role" in argv and argv[argv.index(b"--role") + 1:][:1] == [t["role"].encode()]
            if not ours:
                continue  # PID가 다른 프로세스로 재사용됐다
        except OSError:
            continue  # 확인할 수 없으면 죽이지 않는다
        try:
            os.kill(pid, signal.SIGTERM)
            hit += 1
            print(f"취소: {who(t)} {t['sha'][:12]} ({'실행' if t['state'] == 'run' else '대기'}, pid {pid})")
        except OSError:
            pass
    if not hit:
        print(f"취소할 검사가 없다: {project}/{role}")


def cmd_list():
    if not os.path.isdir(TICKETS):
        print("대기열이 비었다")
        return
    with Mutex():
        running, waiting = ordered(load())
        flags = sorted(os.listdir(URGENT))
    if not running and not waiting:
        print("대기열이 비었다")
    rows = [["순번", "상태", "프로젝트/역할", "SHA", "급함", "경과"]]
    rows += [["-", "실행", who(t), t["sha"][:12], "", ago(t["started"])] for t in running]
    rows += [[str(i + 1), "대기", who(t), t["sha"][:12], "급함" if t["prio"] == 0 else "", ago(t["created"])]
             for i, t in enumerate(waiting)]
    if len(rows) > 1:
        widths = [max(len(r[i]) for r in rows) for i in range(len(rows[0]))]
        for r in rows:
            print("  ".join(c.ljust(w) for c, w in zip(r, widths)).rstrip())
    for f in flags:
        print(f"다음 검사 급함 예약: {f.replace('__', '/', 1)}")


def main():
    argv = sys.argv[1:]
    command = []
    if "--" in argv:
        i = argv.index("--")
        argv, command = argv[:i], argv[i + 1:]
    ap = argparse.ArgumentParser(description="무거운 검사의 공용 대기열")
    sub = ap.add_subparsers(dest="cmd")
    r = sub.add_parser("run")
    r.add_argument("--role", required=True)
    r.add_argument("--sha", default="")
    r.add_argument("--project")
    r.add_argument("--timeout", type=int, default=0)
    r.add_argument("--log")
    r.add_argument("--wait-file")
    r.add_argument("--supersede", action="store_true")
    d = sub.add_parser("drop")
    d.add_argument("role")
    d.add_argument("--sha", default="")
    d.add_argument("--project")
    d.add_argument("--running", action="store_true")
    for name in ("urgent", "normal"):
        p = sub.add_parser(name)
        p.add_argument("role")
        p.add_argument("--project")
    c = sub.add_parser("cancel")
    c.add_argument("--sha", default="")
    sub.add_parser("ahead")
    sub.add_parser("list")
    a = ap.parse_args(argv)
    if a.cmd == "run":
        a.command = command
        sys.exit(cmd_run(a))
    if a.cmd == "drop":
        cmd_drop(a)
    elif a.cmd in ("urgent", "normal"):
        cmd_mark(a, 0 if a.cmd == "urgent" else 5)
    elif a.cmd == "cancel":
        cmd_cancel(a)
    elif a.cmd == "ahead":
        if not os.path.isdir(TICKETS):
            print(0)
            return
        with Mutex():
            print(len(load()))
    else:
        cmd_list()
        if not argv:
            print("쓰는 법: herdr-queue -h · 대기 줄 빼기: herdr-queue drop <역할> [--sha S] [--project P]")


if __name__ == "__main__":
    main()
