#!/usr/bin/env bash
# 하네스가 만든 캐시를 정리한다. 실행기가 PATH에 넣으므로 어느 폴더에서나 쓴다. herdr-check의 디스크 가드도 부른다.
#   herdr-clean            이 프로젝트의 하네스 캐시를 지운다
#   herdr-clean --dry-run  지울 것과 크기만 보여 준다
# 지우는 것(하네스가 다시 만든다):
#   - 검사용 worktree(~/.cache/herdr/check/<프로젝트>/*)와 검증용 worktree(~/.cache/herdr/verify/<프로젝트>/*) 중
#     지금 쓰지 않는 것(잠금이 비어 있는 것). 쓰는 중인 것은 건드리지 않는다
#   - git worktree 목록의 지워진 항목(git worktree prune)
#   - 14일 지난 검사·검증 로그(~/.claude/herdr/handoff/<프로젝트>/.*.log, .*.out)
# 지우지 않는 것: 작업 worktree(docs/.worktrees), 기록(tsv, md), Docker·패키지 캐시. 그 밖의 정리는 사용자 승인 대상이다.
set -uo pipefail
BIN="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
dry=0; [[ "${1:-}" == --dry-run ]] && dry=1
if common="$(git -C "$BIN" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"; then ROOT="$(dirname "$common")"; else ROOT="$(cd "$BIN/../.." && pwd)"; fi
project="${HERDR_PROJECT:-$(basename "$ROOT")}"
cache="${XDG_CACHE_HOME:-$HOME/.cache}/herdr"
dir="$HOME/.claude/herdr/handoff/$project"
size_kb() { du -sk "$@" 2>/dev/null | awk '{ s += $1 } END { print s + 0 }'; }
freed=0 n=0

for wt in "$cache/check/$project"/* "$cache/verify/$project"/*; do
  [[ -d "$wt" ]] || continue
  lock="$wt.lock"
  # 잠금을 쥔 채 지운다(확인과 삭제 사이에 다른 검사가 잡지 못하게). flock이 없으면 쓰는 중인지 알 수 없어 두지 않는다
  if [[ -e "$lock" ]] && ! command -v flock >/dev/null; then echo "잠금을 확인할 수 없어 둔다: ${wt#"$cache"/}"; continue; fi
  exec 7>>"$lock"
  if command -v flock >/dev/null && ! flock -n 7; then exec 7>&-; echo "쓰는 중이라 둔다: ${wt#"$cache"/}"; continue; fi
  kb="$(size_kb "$wt")"
  echo "지움: ${wt#"$cache"/} ($((kb / 1024))MB)"
  [[ $dry -eq 1 ]] || { git -C "$ROOT" worktree remove --force "$wt" 2>/dev/null || rm -rf "$wt"; }
  exec 7>&-
  freed=$((freed + kb)) n=$((n + 1))
done
[[ $dry -eq 1 ]] || git -C "$ROOT" worktree prune 2>/dev/null

if [[ -d "$dir" ]]; then
  while IFS= read -r f; do
    kb="$(size_kb "$f")"
    [[ $dry -eq 1 ]] || rm -f "$f"
    freed=$((freed + kb)) n=$((n + 1))
  done < <(find "$dir" -maxdepth 1 -type f \( -name '.*.log' -o -name '.*.out' \) -mtime +14 2>/dev/null)
fi
if [[ $dry -eq 1 ]]; then echo "지울 것: ${n}개, 약 $((freed / 1024))MB (--dry-run)"; else echo "정리함: ${n}개, 약 $((freed / 1024))MB"; fi
