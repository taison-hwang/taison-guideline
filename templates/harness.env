# herdr 세션 실행기(.agents/bin/herdr-session)가 읽는 프로젝트 설정. `harness sync`는 이 파일을 덮어쓰지 않는다.

# 1: 권한 확인 없이 도는 자율 모드(claude --dangerously-skip-permissions, codex --yolo).
# 운영 자원·비밀에 닿는 프로젝트는 0으로 둔다. 0이면 권한 확인에서 세션이 멈추므로 자율주행이 끊긴다.
HERDR_AUTONOMOUS=1

# 동시에 띄울 수 있는 워커 수
HERDR_MAX_WORKERS=3

# 소프트 신호와 auto-compact 임계(토큰). 1M 창 모델 기준이다. 200K 창 모델을 쓰면 낮춘다.
HERDR_SOFT_SIGNAL_TOKENS=300000
HERDR_COMPACT_TOKENS=400000
